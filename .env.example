# FinanceIQ — Environment Variables
# Copy this file to .env and fill in your values

# HuggingFace API key (required) — get from https://huggingface.co/settings/tokens
HF_API_KEY=

# HuggingFace Model (optional) — defaults to Qwen/Qwen2.5-72B-Instruct
HF_MODEL=Qwen/Qwen2.5-72B-Instruct

# Notion token (required for live Notion writes)
NOTION_TOKEN=
NOTION_API_KEY=

# Notion Parent Page ID (optional) — the page under which FinanceIQ creates its workspace
NOTION_PARENT_PAGE_ID=
